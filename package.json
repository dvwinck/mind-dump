{
  "name": "mind-dump",
  "version": "1.0.0",
  "private": true,
  "description": "Bloco de notas para dump mental - SPA + PWA offline-first",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "npx serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": "prettier --write"
  },
  "keywords": [
    "notes",
    "pwa",
    "offline-first",
    "mental-dump"
  ],
  "author": "Diogo Winck",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvwinck/mind-dump.git"
  },
  "bugs": {
    "url": "https://github.com/dvwinck/mind-dump/issues"
  },
  "homepage": "https://dvwinck.github.io/mind-dump/",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.4"
  }
}
